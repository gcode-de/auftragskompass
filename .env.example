# Copy outside this repository; create a separate password file with mode 600.
AK_DB_PASSWORD_FILE=/absolute/path/outside/repository/db-password
AK_ADMIN_PORT=8080
AK_API_PORT=3100

# Set these to the owner UID/GID of the external mode-600 password file (id -u / id -g).
AK_UID=1000
AK_GID=1000
# Direct Node operation (Compose sets its internal values automatically):
AK_DB_HOST=127.0.0.1
AK_DB_PORT=5432
AK_DB_NAME=auftragskompass
AK_DB_USER=ak
AK_HOST=127.0.0.1
AK_PORT=3000
AK_LOG_LEVEL=info
AK_TIMEZONE=Europe/Berlin
AK_BUILD_REVISION=development

# Google OIDC: opt in with infrastructure/compose.auth.yaml and an HTTPS proxy.
AK_AUTH_ENABLED=false
AK_AUTH_ORIGIN=https://admin.example.invalid
AK_TENANT_ID=11111111-1111-4111-8111-111111111111
AK_GOOGLE_CLIENT_ID=replace-with-google-client-id
AK_GOOGLE_SECRET_FILE=/absolute/path/outside/repository/google-client-secret

# First start only. Remove after successful first login; restarting never re-grants access.
AK_BOOTSTRAP_EMAIL=synthetic-owner@example.invalid
AK_TENANT_NAME=Example business

# Alternative native password login (no Google client required):
# AK_AUTH_MODE=password
# AK_BOOTSTRAP_USERNAME=fictional.owner
# AK_BOOTSTRAP_PASSWORD_FILE=/absolute/path/outside/repository/initial-password
