# Copy outside this repository; create a separate password file with mode 600.
AK_DB_PASSWORD_FILE=/absolute/path/outside/repository/db-password
AK_ADMIN_PORT=8080
AK_API_PORT=3100

# Set these to the owner UID/GID of the external mode-600 password file (id -u / id -g).
AK_UID=1000
AK_GID=1000
# Direct Node operation (Compose sets its internal values automatically):
AK_DB_HOST=127.0.0.1
AK_DB_PORT=5432
AK_DB_NAME=auftragskompass
AK_DB_USER=ak
AK_HOST=127.0.0.1
AK_PORT=3000
AK_LOG_LEVEL=info
AK_TIMEZONE=Europe/Berlin
AK_BUILD_REVISION=development

# Google OIDC: opt in with infrastructure/compose.auth.yaml and an HTTPS proxy.
AK_AUTH_ENABLED=false
AK_AUTH_ORIGIN=https://admin.example.invalid
AK_TENANT_ID=11111111-1111-4111-8111-111111111111
AK_GOOGLE_CLIENT_ID=replace-with-google-client-id
AK_GOOGLE_SECRET_FILE=/absolute/path/outside/repository/google-client-secret

# Website option drain (worker, H032). All five values are OPTIONAL.
# AK_INQUIRY_TENANT_ID and AK_INQUIRY_OPERATOR_ID must be set together to
# configure the automatic drain. Leave both absent (or empty) to keep it off:
# the worker stays healthy, no timer runs, and every website entry simply remains
# visible in the exceptions inbox for manual takeover. Set exactly one of them,
# or a value that is not a UUID, and the worker reports a configuration error
# and stays unready, because that is a typo rather than an opt-out.
# AK_INQUIRY_OPTION_DRAIN (BKP004.1) is the separate activation gate for the
# automatic timer: exactly `on` starts it, `off` or an absent value pauses it
# with one `website_option_drain_inactive` warning while the worker stays ready.
# Every other value (`1`, `true`, `ON`, an empty string) is a configuration error
# and keeps the worker unready. The pause never touches gateway receipt, staging,
# acknowledgement, sync or manual takeover.
# WARNING: `on` converts the complete local backlog into options automatically.
# Before enabling it, create the read-only backlog overview described in
# docs/website-inquiry-intake.md ("Aktivierungsgrenze und Rollout") and decide as
# the operator. Compose and the Podman worker quadlet pass this value through
# explicitly paused (`off`); changing it to `on` is a deliberate edit of the
# deployment, never a default.
# AK_INQUIRY_OPERATOR_ID is the user id of this installation's bootstrap
# account, so it is not portable across installs or restores.
# AK_INQUIRY_DEFAULT_CONTACT_COUNTRY is the deployment value for new contacts;
# the operator decision of 19.10.2026 is DE, but no country is hardcoded in the
# domain. Without it, an entry that needs a new contact stays a visible
# contact_review exception; existing exact contacts are still reused.
# AK_INQUIRY_TENANT_ID=11111111-1111-4111-8111-111111111111
# AK_INQUIRY_OPERATOR_ID=22222222-2222-4222-8222-222222222222
# AK_INQUIRY_OPTION_DRAIN=off
# AK_INQUIRY_DEFAULT_CONTACT_COUNTRY=DE
# The interval is clamped to 5000-600000 ms; the default is 30000.
# AK_INQUIRY_OPTION_INTERVAL_MS=30000

# First start only. Remove after successful first login; restarting never re-grants access.
AK_BOOTSTRAP_EMAIL=synthetic-owner@example.invalid
AK_TENANT_NAME=Example business

# Alternative native password login (no Google client required):
# AK_AUTH_MODE=password
# AK_BOOTSTRAP_USERNAME=fictional.owner
# AK_BOOTSTRAP_PASSWORD_FILE=/absolute/path/outside/repository/initial-password
