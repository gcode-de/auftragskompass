[Unit]
Description=AuftragsKompass test public gateway
Requires=ak-test-database.service
After=ak-test-database.service

[Container]
Image=docker.io/REPLACE_IMAGE:runtime-REPLACE_REVISION
ContainerName=ak-test-gateway
Network=ak-test.network
NetworkAlias=gateway
User=1000:1000
Secret=ak-test-db,type=mount,target=db_password,uid=1000,gid=1000,mode=0400
Secret=ak-test-gateway-storage,type=mount,target=gateway_storage_keys,uid=1000,gid=1000,mode=0400
Secret=ak-test-gateway-sync,type=mount,target=gateway_sync_keys,uid=1000,gid=1000,mode=0400
Environment=AK_DB_HOST=database
Environment=AK_DB_NAME=auftragskompass
Environment=AK_DB_USER=ak
Environment=AK_DB_PASSWORD_FILE=/run/secrets/db_password
Environment=AK_HOST=127.0.0.1
Environment=AK_PORT=3002
Environment=AK_TIMEZONE=Europe/Berlin
Environment=AK_BUILD_REVISION=REPLACE_REVISION
Environment=AK_INQUIRY_TENANT_ID=REPLACE_INQUIRY_TENANT_ID
Environment=AK_INQUIRY_ALLOWED_ORIGINS=REPLACE_INQUIRY_ALLOWED_ORIGINS
Environment=AK_INQUIRY_MAX_STORED=REPLACE_INQUIRY_MAX_STORED
Environment=AK_INQUIRY_RETENTION_HOURS=REPLACE_INQUIRY_RETENTION_HOURS
Environment=AK_INQUIRY_RESPONSE_KEY_ID=REPLACE_INQUIRY_RESPONSE_KEY_ID
Environment=AK_INQUIRY_STORAGE_KEYS_FILE=/run/secrets/gateway_storage_keys
Environment=AK_INQUIRY_SYNC_KEYS_FILE=/run/secrets/gateway_sync_keys
Exec=node apps/gateway/dist/main.js
RunInit=true
NoNewPrivileges=true
HealthCmd=["node","-e","fetch('http://127.0.0.1:3002/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
HealthInterval=5s
HealthTimeout=3s
HealthRetries=12
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
